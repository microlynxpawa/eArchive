PORT=

# Database credentials
DBNAME=
DBPASS=
DBUSER=

SALT=10

# Folder directory
FOLDER=
DEFAULT_FOLDERS=
SECRET=

# Daily backup path
DB_DAILY_BCP=

# MySQL bin directory (for mysqldump)
MYSQLBINDIR=

# Static file paths
Profile_Pictures=
Temp_Upload_Folder_Path=
TEMP_FOLDERS=

# JWT for Remember Me
JWT_SECRET=

# Email (SMTP) for Forgot Password
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SERVICE=

# AWS S3 Storage (fill in values to enable S3 provider)
AWS_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# --- AI query understanding (ticket #13, Phase 3) -------------------------
# Off by default. Search works fully without it: the deterministic rules
# parser is both the default and the fallback.
# ONLY the typed search phrase and the branch/department/user name lists are
# sent to the provider. Document contents never leave the server.
# Note the phrase itself can contain personal data ("Kwame Mensah's payslip"),
# so switching this on belongs in the client's data agreement first.
AI_QUERY_ENABLED=false
# openai-compatible (OpenRouter, Groq, Ollama, LM Studio, Azure) or anthropic
AI_PROVIDER=openai-compatible
# e.g. https://openrouter.ai/api/v1 — leave blank for Anthropic's default
AI_BASE_URL=
# a small, fast instruct model; this job is formatting, not reasoning
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT_MS=3000

# --- Search indexing ------------------------------------------------------
# Set to false to stop this machine from indexing (search still works).
SEARCH_INDEXING_ENABLED=true
# Tesseract workers. 2 is right for a normal server; 1 for a small one.
OCR_WORKERS=2
